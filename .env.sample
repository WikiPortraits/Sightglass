# Contact email for API User-Agent
CONTACT_EMAIL=your.email@example.com

# Session Configuration (REQUIRED)
# Must be at least 32 characters
# Can generate using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_secret_string_minimum_32_characters

# WIKIMEDIA OAUTH (REQUIRED)
# This application requires OAuth authentication to manage load and allow saving results
# Get credentials from https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
WIKIMEDIA_CONSUMER_KEY=your_consumer_key_here
WIKIMEDIA_CONSUMER_SECRET=your_consumer_secret_here

# OAuth Wiki (where consumer is registered)
OAUTH_WIKI=meta.wikimedia.org

# Comma-separated CentralAuth user IDs allowed to use the /admin view
# ADMIN_CENTRAL_IDS=

# SERVER CONFIGURATION
# Server port
PORT=3000

# Environment (development or production)
NODE_ENV=development

# Proxy Configuration
# Number of reverse-proxy hops in front of the app (nginx, Apache, etc.)
# This ensures correct IP addresses for rate limiting; 0/false disables
# TRUST_PROXY=1

# Days before unsaved jobs are automatically deleted (default: 30)
# JOB_RETENTION_DAYS=30

# Extra days a job survives after its last save is removed, so accidental
# unsaves are recoverable by re-saving (default: 7)
# JOB_UNSAVE_GRACE_DAYS=7

# Max jobs processed at once (default: 3)
# All jobs share one global request budget
# MAX_CONCURRENT_JOBS=3

# Max files a single job may analyze (default: 300000)
# Jobs on category trees larger than this fail with an error
# MAX_FILES_PER_JOB=300000
